{
  "name": "orange3-workflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --hostname 127.0.0.1 --port 3000",
    "dev:clean": "rm -rf .next-dev && npm run dev",
    "build": "NEXT_DIST_DIR=.next next build",
    "start": "NEXT_DIST_DIR=.next next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
