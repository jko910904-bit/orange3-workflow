        "label": "아이디",
        "placeholder": "5~16자리(영문 대문자+숫자)",
        "autoComplete": "username"
      }
    },
    {
      "componentId": "input",
      "variant": "Password",
      "size": "M",
      "displayName": "Password Input",
      "props": {
        "label": "비밀번호",
        "placeholder": "8~20자리(영문+특수문자+숫자 조합)",
